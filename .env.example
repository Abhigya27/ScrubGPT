# Copy this file to .env for local development. Never commit real API keys.

# -------------------------
# Persistent vector store
# -------------------------
# The local app still uses the existing Qdrant persistent store.
QDRANT_URL=
QDRANT_API_KEY=

# -------------------------
# Local-first runtime
# -------------------------
LOCAL_MODE=true

# -------------------------
# Answer / enhancement LLMs
# -------------------------
# Gemini is the recommended local configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional Groq key/model if you want a different answer backend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# -------------------------
# YouTube transcript extraction
# -------------------------
ALLOW_GENERATED_TRANSCRIPT=true
TRANSCRIPT_PROVIDER_ORDER=youtube
TRANSCRIPT_REQUEST_MIN_DELAY_SECONDS=8
TRANSCRIPT_REQUEST_MAX_DELAY_SECONDS=15
TRANSCRIPT_BETWEEN_VIDEOS_SECONDS=10
TRANSCRIPT_MAX_RETRIES=2
TRANSCRIPT_RETRY_BASE_SECONDS=10
TRANSCRIPT_RETRY_MAX_SECONDS=60
TRANSCRIPT_PROVIDER_COOLDOWN_SECONDS=900
TRANSCRIPT_PAUSE_SECONDS=900

# Optional direct proxy. Leave blank unless your local network needs one.
YOUTUBE_HTTP_PROXY=
YOUTUBE_HTTPS_PROXY=

# -------------------------
# Local caching / library metadata
# -------------------------
CACHE_DIR=data/cache
LIBRARY_METADATA_PATH=data/library.json

# -------------------------
# Playlist limits: 0 = unlimited
# -------------------------
MAX_VIDEOS_PER_JOB=0
MAX_TOTAL_HOURS=0
MAX_SINGLE_VIDEO_HOURS=0

# -------------------------
# Translation
# -------------------------
# Chosen for high-throughput translation. It has a 1M-token context window and a large batch allowance.
TRANSLATE_PROVIDER=gemini
TRANSLATE_MODEL=gemini-3.5-flash-lite
TRANSLATE_BATCH_SIZE=8
TRANSLATE_BATCH_MAX_CHARS=16000
TRANSLATE_MAX_CONCURRENCY=6
TRANSLATION_DAILY_CHUNK_BUDGET=0
QUOTA_MAX_WAIT_SECONDS=90

# -------------------------
# Retrieval / query enhancement
# -------------------------
QUERY_ENHANCE_ENABLED=true
QUERY_ENHANCE_MAX_REWRITES=2
QUERY_ENHANCE_MAX_KEYWORDS=6
QUERY_ENHANCE_MAX_WAIT_SECONDS=8
EXPANDED_QUERY_DISCOUNT=0.9
ENHANCE_PROVIDER=gemini
ENHANCE_MODEL=gemini-3.5-flash-lite

# Keep the baseline embedding and chunking from the existing project.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SECONDS=90
CHUNK_OVERLAP_SECONDS=20
MIN_CHUNK_WORDS=15
MAX_QUESTION_CHARS=500
RETRIEVAL_THRESHOLD=0.55
MAX_RESULTS=12
SPARSE_WEIGHT=0.65
DENSE_WEIGHT=0.35
RELATIVE_SCORE_FLOOR=0.8
MIN_DENSE_SIMILARITY=0.2
STRIP_NAVIGATION_WORDS=true
SPARSE_HALF_SATURATION_TERMS=0.6
PERIOD_GAP_SECONDS=180
FASTEMBED_CACHE_DIR=

# -------------------------
# Future/public-demo knobs (ignored by local mode)
# -------------------------
RATE_LIMIT_REQUESTS=2
RATE_LIMIT_GLOBAL_REQUESTS=3
RATE_LIMIT_WINDOW_SECONDS=60
SEARCH_RATE_LIMIT_REQUESTS=6
SEARCH_RATE_LIMIT_GLOBAL_REQUESTS=12
INGEST_RATE_LIMIT_REQUESTS=2
INGEST_RATE_LIMIT_WINDOW_SECONDS=600

# -------------------------
# Local Streamlit frontend
# -------------------------
API_BASE_URL=http://localhost:8000
